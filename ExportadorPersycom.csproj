<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permite compilar (no ejecutar) este target de Windows desde Linux, para verificar
         el codigo en esta maquina; no afecta al build real en Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExportadorPersycom</RootNamespace>
    <AssemblyName>ExportadorPersycom</AssemblyName>
    <ApplicationIcon>Recursos\persycom.ico</ApplicationIcon>
    <Product>Exportador Persycom</Product>
    <Company>Persycom</Company>
    <Version>1.0.0</Version>

    <!-- Empaquetado para el cliente: un unico .exe con el runtime dentro, sin instalar nada. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Recursos\logo-persycom.png" />
    <EmbeddedResource Include="Recursos\logo-persycom.png" />
    <None Remove="Recursos\persycom.ico" />
    <EmbeddedResource Include="Recursos\persycom.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.Odbc" Version="8.0.1" />
    <!-- Conexion manual a SQL Server (tarea 0001): el proveedor mantenido, en vez de System.Data.SqlClient. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

</Project>
